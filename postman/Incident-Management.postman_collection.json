{
  "info": {
    "_postman_id": "c3d75c24-incident-management",
    "name": "Incident Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"token","value":""},
    {"key":"incidentId","value":""}
  ],
  "item": [
    {
      "name":"Register",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"deepak\",\"email\":\"deepak@example.com\",\"phone\":\"9876543210\",\"address\":\"Test Address\",\"pincode\":\"110001\",\"city\":\"New Delhi\",\"country\":\"India\",\"password\":\"Password123\"}"},"url":{"raw":"{{baseUrl}}/api/auth/register","host":["{{baseUrl}}"],"path":["api","auth","register"]}}
    },
    {
      "name":"Login",
      "event":[{"listen":"test","script":{"exec":["pm.test('Login successful', function () { pm.response.to.have.status(200); });","const json = pm.response.json(); pm.collectionVariables.set('token', json.token);"]}}],
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"deepak@example.com\",\"password\":\"Password123\"}"},"url":{"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]}}
    },
    {
      "name":"Create Incident",
      "event":[{"listen":"test","script":{"exec":["const json = pm.response.json(); pm.collectionVariables.set('incidentId', json.incidentId);"]}}],
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"organizationType\":\"ENTERPRISE\",\"incidentDetails\":\"Sample incident for assignment\",\"reportedDateTime\":\"2026-08-20T12:00:00\",\"priority\":\"HIGH\",\"status\":\"OPEN\"}"},"url":{"raw":"{{baseUrl}}/api/incidents","host":["{{baseUrl}}"],"path":["api","incidents"]}}
    },
    {
      "name":"Get My Incidents",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/api/incidents","host":["{{baseUrl}}"],"path":["api","incidents"]}}
    },
    {
      "name":"Search Incident",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/api/incidents/search?incidentId={{incidentId}}","host":["{{baseUrl}}"],"path":["api","incidents","search"],"query":[{"key":"incidentId","value":"{{incidentId}}"}]}}
    },
    {
      "name":"Update Incident",
      "request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"organizationType\":\"GOVERNMENT\",\"incidentDetails\":\"Updated incident details\",\"reportedDateTime\":\"2026-08-20T12:00:00\",\"priority\":\"MEDIUM\",\"status\":\"IN_PROGRESS\"}"},"url":{"raw":"{{baseUrl}}/api/incidents/{{incidentId}}","host":["{{baseUrl}}"],"path":["api","incidents","{{incidentId}}"]}}
    },
    {
      "name":"Close Incident",
      "request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"organizationType\":\"GOVERNMENT\",\"incidentDetails\":\"Incident resolved\",\"reportedDateTime\":\"2026-08-20T12:00:00\",\"priority\":\"MEDIUM\",\"status\":\"CLOSED\"}"},"url":{"raw":"{{baseUrl}}/api/incidents/{{incidentId}}","host":["{{baseUrl}}"],"path":["api","incidents","{{incidentId}}"]}}
    },
    {
      "name":"Try Edit Closed Incident",
      "request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"organizationType\":\"ENTERPRISE\",\"incidentDetails\":\"This should fail\",\"reportedDateTime\":\"2026-08-20T12:00:00\",\"priority\":\"LOW\",\"status\":\"OPEN\"}"},"url":{"raw":"{{baseUrl}}/api/incidents/{{incidentId}}","host":["{{baseUrl}}"],"path":["api","incidents","{{incidentId}}"]}}
    }
  ]
}
